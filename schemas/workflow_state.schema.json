{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow State",
  "type": "object",
  "required": ["schema_version", "opportunity_id", "workflow_name", "current_stage", "status"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "opportunity_id": {
      "type": "string"
    },
    "workflow_name": {
      "type": "string",
      "enum": ["opportunity-evaluation"]
    },
    "current_stage": {
      "type": "string",
      "enum": ["INIT", "TEARDOWN", "SIX_LENS", "SIX_LENS_GATE", "FIT_ASSESSMENT", "FIT_GATE", "GENERATE"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "RUNNING", "COMPLETED", "WAITING_USER", "CONFIRMED", "STOPPED", "FAILED", "REJECTED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stage_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "COMPLETED", "WAITING_USER", "CONFIRMED", "STOPPED", "FAILED", "REJECTED"]
          },
          "output": {
            "type": "object"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "hitl": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["N/A", "WAITING", "CONFIRMED", "REJECTED"]
        },
        "confirmed": {
          "type": "boolean"
        },
        "user_decision": {
          "type": ["string", "null"],
          "enum": ["continue", "stop", null]
        },
        "prompt": {
          "type": ["string", "null"]
        },
        "waiting_since": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "user_reason": {
          "type": "string"
        }
      }
    }
  }
}
